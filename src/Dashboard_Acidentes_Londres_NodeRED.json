        "type": "function",
        "z": "06dadb7a0a8e6dfd",
        "name": "Preparar Meteorologia Gravidade",
        "func": "\nconst dados = msg.payload;\n\nif (!Array.isArray(dados)) {\n    node.error(\"O ficheiro de meteorologia e gravidade não contém uma lista JSON.\", msg);\n    return null;\n}\n\nmsg.payload = dados.map(item => ({\n    meteorologia: item.condicao_meteorologica,\n    gravidade: item.descricao_gravidade,\n    total: Number(item.total_acidentes)\n}));\n\nreturn msg;\n",
