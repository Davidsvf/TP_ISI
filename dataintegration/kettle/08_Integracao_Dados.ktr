        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
var descricoes = {
    "0": "Céu limpo",
    "1": "Maioritariamente limpo",
    "2": "Parcialmente nublado",
    "3": "Encoberto",
    "45": "Nevoeiro",
    "48": "Nevoeiro com geada",
    "51": "Chuvisco fraco",
    "53": "Chuvisco moderado",
    "55": "Chuvisco intenso",
    "56": "Chuvisco gelado fraco",
    "57": "Chuvisco gelado intenso",
    "61": "Chuva fraca",
    "63": "Chuva moderada",
    "65": "Chuva intensa",
    "66": "Chuva gelada fraca",
    "67": "Chuva gelada intensa",
    "71": "Queda de neve fraca",
    "73": "Queda de neve moderada",
    "75": "Queda de neve intensa",
    "77": "Grãos de neve",
    "80": "Aguaceiros fracos",
    "81": "Aguaceiros moderados",
    "82": "Aguaceiros violentos",
    "85": "Aguaceiros de neve fracos",
    "86": "Aguaceiros de neve intensos",
    "95": "Trovoada",
    "96": "Trovoada com granizo fraco",
    "97": "Trovoada forte",
    "99": "Trovoada com granizo forte"
};

var codigo = String(parseInt(codigo_meteorologia, 10));

var condicao_meteorologica =
    descricoes[codigo] || "Desconhecido";
</jsScript_script>
      </jsScript>
