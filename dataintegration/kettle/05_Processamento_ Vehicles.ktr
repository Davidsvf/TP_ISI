  <step>
    <name>Classificar Sexo</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>sex_of_driver</field_to_use>
    <target_field>sexo_condutor</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>1</source_value>
        <target_value>Masculino</target_value>
      </field>
      <field>
        <source_value>2</source_value>
        <target_value>Feminino</target_value>
      </field>
      <field>
        <source_value>3</source_value>
        <target_value>Não Identificado</target_value>
      </field>
      <field>
        <source_value>-1</source_value>
        <target_value>Desconhecido</target_value>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
