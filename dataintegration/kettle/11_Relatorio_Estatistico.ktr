      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here


var corpo_email =
    "RELATORIO ESTATISTICO - ACIDENTES DE LONDRES\r\n" +
    "Periodo: Agosto de 2025\r\n" +
    "========================================\r\n\r\n" +

    "1. RESUMO GERAL\r\n\r\n" +
    "Total de acidentes: " + total_acidentes + "\r\n" +
    "Total de veiculos: " + total_veiculos + "\r\n" +
    "Total de vitimas: " + total_vitimas + "\r\n" +
    "Temperatura media: " + temperatura_media + " °C\r\n" +
    "Acidentes graves: " + total_graves + "\r\n" +
    "Acidentes fatais: " + total_fatais + "\r\n\r\n" +

    "========================================\r\n\r\n" +

    "2. DISTRIBUICAO POR SEXO\r\n\r\n" +
    texto_sexo.replace(/,\s*/g, "\r\n") + "\r\n\r\n" +

    "========================================\r\n\r\n" +

    "3. DISTRIBUICAO POR FAIXA ETARIA\r\n\r\n" +
    texto_faixa.replace(/,\s*/g, "\r\n") + "\r\n\r\n" +

    "========================================\r\n\r\n" +

    "4. FAIXA ETARIA VS GRAVIDADE\r\n\r\n" +
    texto_faixa_gravidade.replace(/,\s*/g, "\r\n") + "\r\n\r\n" +

    "========================================\r\n\r\n" +

    "5. PERIODO DO DIA VS GRAVIDADE\r\n\r\n" +
    texto_periodo.replace(/,\s*/g, "\r\n") + "\r\n\r\n" +

    "========================================\r\n\r\n" +

    "6. METEOROLOGIA VS GRAVIDADE\r\n\r\n" +
    texto_meteorologia.replace(/,\s*/g, "\r\n") + "\r\n\r\n" +

    "========================================\r\n\r\n" +
    "Em anexo encontram-se os 6 ficheiros JSON " +
    "com as estatisticas detalhadas.\r\n\r\n" +
    "Relatorio gerado automaticamente pelo Pentaho Kettle.";

</jsScript_script>
      </jsScript>
    </jsScripts>
