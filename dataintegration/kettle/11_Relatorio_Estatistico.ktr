  <step>
    <name>Estatisticas Gerais</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>AcidentesLondresDB</connection>
    <sql>
SELECT
    a.total_acidentes,
    a.total_vitimas,
    v.total_veiculos,
    a.temperatura_media,
    a.total_graves,
    a.total_fatais
FROM
(
    SELECT
        COUNT(*) AS total_acidentes,
        SUM(number_of_casualties) AS total_vitimas,
        ROUND(AVG(temperatura), 2) AS temperatura_media,
        SUM(CASE
            WHEN gravidade_acidente = 'Grave'
            THEN 1 ELSE 0
        END) AS total_graves,
        SUM(CASE
            WHEN gravidade_acidente = 'Fatal'
            THEN 1 ELSE 0
        END) AS total_fatais
    FROM dbo.Acidentes
) a
CROSS JOIN
(
    SELECT COUNT(*) AS total_veiculos
    FROM dbo.Veiculos
) v;
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
