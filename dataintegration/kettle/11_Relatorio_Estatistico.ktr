    <connection>AcidentesLondresDB</connection>
    <sql>
SELECT
    v.faixa_etaria,
    a.gravidade_acidente,
    COUNT(*) AS total_veiculos
FROM dbo.Veiculos v
INNER JOIN dbo.Acidentes a
    ON v.collision_index = a.collision_index
GROUP BY
    v.faixa_etaria,
    a.gravidade_acidente
ORDER BY
    v.faixa_etaria,
    a.gravidade_acidente;
</sql>
